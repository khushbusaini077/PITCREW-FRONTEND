# Public variables only. Never put service-role, admin or sensor keys here.
# Backend base URL: HTTPS, no trailing slash, no /v1 suffix.
NEXT_PUBLIC_API_BASE_URL=https://<our-render-service>.onrender.com
# Optional: enables Realtime-triggered refetch (read-only anon key). Omit both to rely on the 10 s poll.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Use ONE of these two names (the app reads either). Both are the public, read-only key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional staff gate for /dashboard (server-side only, never NEXT_PUBLIC). Leave unset for open access.
# Set these in Vercel > Project > Settings > Environment Variables, then redeploy.
# STAFF_USERNAME=municipality
# STAFF_PASSWORD=<long-random-password>
